# Sanity (blog) — from https://www.sanity.io/manage
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Public URL of the site (used for metadata / Open Graph)
NEXT_PUBLIC_SITE_URL=https://netherninjas.com

# Contact form (https://resend.com) — optional until you want to receive emails
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Must be a verified domain on Resend, e.g. "Nether Ninjas <hello@netherninjas.com>"
CONTACT_FROM_EMAIL=
